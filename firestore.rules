rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A user's own document. Every other user's account is only ever
    // reachable through Cloud Functions (see functions/index.js's
    // toPublicFamily comment) — those run with the Admin SDK and aren't
    // subject to these rules at all, so this only needs to cover the
    // "read/write my own doc" case the client actually does directly
    // (onboarding, favorites, calendar connection state).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Direct messages between two families. conversationId is a
    // deterministic sorted-uid pair (see lib/messages.ts) so the same two
    // people always land in the same thread, but these rules don't rely on
    // that format — only on being one of the two listed participants.
    match /conversations/{conversationId} {
      // resource is null for a document that doesn't exist yet — checking
      // that first, before dereferencing resource.data, matters here:
      // Firestore evaluates security rules for a get() even when the
      // target doesn't exist, and a rule that reaches into resource.data
      // on a null resource is denied outright rather than cleanly
      // reporting "not found". (lib/messages.ts's getOrCreateConversation
      // avoids ever needing this read on a not-yet-created conversation in
      // the first place, but this guard keeps the rule itself correct on
      // its own terms.)
      function isParticipant() {
        return request.auth != null && resource != null && request.auth.uid in resource.data.participantUids;
      }

      allow read: if isParticipant();
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participantUids.size() == 2;
      // Only lastMessage/lastMessageAt should ever change after creation —
      // the participant list is fixed for the life of a conversation. Set
      // equality (hasAll both ways) rather than array equality (==) — the
      // client writes participantUids as [myUid, otherUid], caller-order
      // rather than sorted, so the exact same pair of people can land in
      // different array order depending on who happened to write the doc
      // first; a strict == would then wrongly deny every later participant
      // from ever touching their own conversation.
      allow update: if isParticipant()
        && request.resource.data.participantUids.size() == 2
        && resource.data.participantUids.hasAll(request.resource.data.participantUids)
        && request.resource.data.participantUids.hasAll(resource.data.participantUids);
      allow delete: if false;

      match /messages/{messageId} {
        // Same reasoning as isParticipant() above, via exists() this time
        // since get() itself (not just .data access) is what would
        // otherwise fail against a conversation that isn't there.
        function isConversationParticipant() {
          return request.auth != null
            && exists(/databases/$(database)/documents/conversations/$(conversationId))
            && request.auth.uid in
               get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        }

        allow read: if isConversationParticipant();
        // Can only ever send as yourself — senderUid can't be spoofed.
        allow create: if isConversationParticipant() && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // A lightweight, denormalized mirror of a playdate proposal — the
    // proposal itself lives as a message in the conversation (see
    // lib/messages.ts's sendProposalMessage); this collection exists only
    // so the dashboard can cheaply find "do I have a pending proposal?"
    // without a collection-group query across every conversation, and so
    // accept/decline status has one place to live.
    match /playdateProposals/{proposalId} {
      allow read: if request.auth != null
        && resource != null
        && request.auth.uid in resource.data.participantUids;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.status == 'proposed';
      // Two people can update status, in different ways: the recipient can
      // respond (proposed -> accepted/declined) while it's still pending,
      // or the creator can cancel (proposed/accepted -> canceled) any time
      // before it's been declined. Either way only the status field may
      // change. diff().affectedKeys().hasOnly(...) rather than comparing
      // every other field to its existing value one by one — a direct
      // `request.resource.data.someField == resource.data.someField` check
      // throws (denying the whole write, not just failing that one
      // comparison) if someField happens to be absent from the map on
      // either side, which a field-by-field pin list is one stale/partial
      // document away from hitting.
      allow update: if request.auth != null
        && resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          (request.auth.uid == resource.data.toUid
            && resource.data.status == 'proposed'
            && request.resource.data.status in ['accepted', 'declined'])
          || (request.auth.uid == resource.data.fromUid
            && resource.data.status in ['proposed', 'accepted']
            && request.resource.data.status == 'canceled')
        );
      allow delete: if false;
    }

    // Community-contributed products/podcasts/articles/events — public
    // content any signed-in family can add. Not another user's private
    // data, so this is a direct client write like
    // conversations/playdateProposals above rather than a Cloud Function.
    match /contributions/{contributionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.contributedByUid == request.auth.uid
        && request.resource.data.type in ['product', 'podcast', 'article', 'event'];
      // Only the original contributor can edit their own contribution, and
      // only its fields/attribution name — type, who contributed it, and
      // when are all pinned to their original value.
      allow update: if request.auth != null
        && resource != null
        && resource.data.contributedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fields', 'contributedByName']);
      // Only the original contributor can delete their own contribution.
      allow delete: if request.auth != null
        && resource != null
        && resource.data.contributedByUid == request.auth.uid;
    }
  }
}
