rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Resolves whoever is actually signed in to the family whose data they
    // should see — mirrors functions/index.js's resolveFamilyUid. A
    // familyMembers/{authUid} doc only exists for someone who accepted a
    // family invite (see functions/index.js's acceptFamilyInvite); the
    // overwhelmingly common case (an account's own owner) has no such doc
    // and resolves to themselves via the ternary's else branch.
    function myFamilyUid() {
      return exists(/databases/$(database)/documents/familyMembers/$(request.auth.uid))
        ? get(/databases/$(database)/documents/familyMembers/$(request.auth.uid)).data.familyUid
        : request.auth.uid;
    }

    // A family's own document — "full access" for an invited member means
    // they can read/write it exactly like the family that invited them.
    // Every other family's account is only ever reachable through Cloud
    // Functions (see functions/index.js's toPublicFamily comment) — those
    // run with the Admin SDK and aren't subject to these rules at all, so
    // this only needs to cover the "read/write my own family's doc" case
    // the client actually does directly (onboarding, favorites, calendar
    // connection state).
    match /users/{uid} {
      allow read, write: if request.auth != null && myFamilyUid() == uid;
    }

    // The mapping an invited member's own uid resolves through above — only
    // ever written by acceptFamilyInvite (Admin SDK, bypasses these rules
    // entirely), so this only needs to allow a member to read their own
    // membership record (used by lib/onboardingProgress.ts's
    // routeSignedInUser to route them straight into the app instead of
    // onboarding).
    match /familyMembers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Invite tokens — the token itself is the unguessable secret (see
    // sendFamilyInvite's comment), and both reading an invite's details
    // (pre-signup, so unauthenticated) and accepting one are only ever done
    // through Cloud Functions, never directly against Firestore.
    match /familyInvites/{token} {
      allow read, write: if false;
    }

    // Expo push tokens for whoever is actually signed in on this device
    // (see lib/pushNotifications.ts) — scoped to the individual person,
    // not the family, since two family members share the family's data
    // but never a device. Cloud Functions read these with the Admin SDK
    // (functions/index.js's pushTokensForFamily), unaffected by this rule.
    match /pushTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Direct messages between two families. conversationId is a
    // deterministic sorted-uid pair (see lib/messages.ts) so the same two
    // people always land in the same thread, but these rules don't rely on
    // that format — only on being one of the two listed participants.
    match /conversations/{conversationId} {
      // resource is null for a document that doesn't exist yet — checking
      // that first, before dereferencing resource.data, matters here:
      // Firestore evaluates security rules for a get() even when the
      // target doesn't exist, and a rule that reaches into resource.data
      // on a null resource is denied outright rather than cleanly
      // reporting "not found". (lib/messages.ts's getOrCreateConversation
      // avoids ever needing this read on a not-yet-created conversation in
      // the first place, but this guard keeps the rule itself correct on
      // its own terms.)
      function isParticipant() {
        return request.auth != null && resource != null && myFamilyUid() in resource.data.participantUids;
      }

      allow read: if isParticipant();
      allow create: if request.auth != null
        && myFamilyUid() in request.resource.data.participantUids
        && request.resource.data.participantUids.size() == 2;
      // Only lastMessage/lastMessageAt should ever change after creation —
      // the participant list is fixed for the life of a conversation. Set
      // equality (hasAll both ways) rather than array equality (==) — the
      // client writes participantUids as [myUid, otherUid], caller-order
      // rather than sorted, so the exact same pair of people can land in
      // different array order depending on who happened to write the doc
      // first; a strict == would then wrongly deny every later participant
      // from ever touching their own conversation.
      allow update: if isParticipant()
        && request.resource.data.participantUids.size() == 2
        && resource.data.participantUids.hasAll(request.resource.data.participantUids)
        && request.resource.data.participantUids.hasAll(resource.data.participantUids);
      allow delete: if false;

      match /messages/{messageId} {
        // Same reasoning as isParticipant() above, via exists() this time
        // since get() itself (not just .data access) is what would
        // otherwise fail against a conversation that isn't there.
        function isConversationParticipant() {
          return request.auth != null
            && exists(/databases/$(database)/documents/conversations/$(conversationId))
            && myFamilyUid() in
               get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        }

        allow read: if isConversationParticipant();
        // Can only ever send as yourself — senderUid can't be spoofed.
        allow create: if isConversationParticipant() && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // A lightweight, denormalized mirror of a playdate proposal — the
    // proposal itself lives as a message in the conversation (see
    // lib/messages.ts's sendProposalMessage); this collection exists only
    // so the dashboard can cheaply find "do I have a pending proposal?"
    // without a collection-group query across every conversation, and so
    // accept/decline status has one place to live.
    match /playdateProposals/{proposalId} {
      allow read: if request.auth != null
        && resource != null
        && myFamilyUid() in resource.data.participantUids;
      allow create: if request.auth != null
        && request.resource.data.fromUid == myFamilyUid()
        && myFamilyUid() in request.resource.data.participantUids
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.status == 'proposed';
      // Two people can update status, in different ways: the recipient can
      // respond (proposed -> accepted/declined) while it's still pending,
      // or the creator can cancel (proposed/accepted -> canceled) any time
      // before it's been declined. Either way only the status field may
      // change. diff().affectedKeys().hasOnly(...) rather than comparing
      // every other field to its existing value one by one — a direct
      // `request.resource.data.someField == resource.data.someField` check
      // throws (denying the whole write, not just failing that one
      // comparison) if someField happens to be absent from the map on
      // either side, which a field-by-field pin list is one stale/partial
      // document away from hitting.
      allow update: if request.auth != null
        && resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          (myFamilyUid() == resource.data.toUid
            && resource.data.status == 'proposed'
            && request.resource.data.status in ['accepted', 'declined'])
          || (myFamilyUid() == resource.data.fromUid
            && resource.data.status in ['proposed', 'accepted']
            && request.resource.data.status == 'canceled')
        );
      // Either family on an already-accepted playdate can add (or replace)
      // a sitter — app/find-sitter.tsx's "Add to Playdate." Same
      // single-field-pin reasoning as the status update above, just for
      // `sitter` instead. Not deeply validated against the real sitter's
      // own doc (would need an extra get() here) — same trust level
      // already given to other denormalized snapshots like contributedByName.
      allow update: if request.auth != null
        && resource != null
        && resource.data.status == 'accepted'
        && myFamilyUid() in resource.data.participantUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sitter'])
        && request.resource.data.sitter.uid is string
        && request.resource.data.sitter.name is string;
      allow delete: if false;
    }

    // Community-contributed products/podcasts/articles/events — public
    // content any signed-in family can add. Not another user's private
    // data, so this is a direct client write like
    // conversations/playdateProposals above rather than a Cloud Function.
    match /contributions/{contributionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.contributedByUid == request.auth.uid
        && request.resource.data.type in ['product', 'podcast', 'article', 'event']
        // Not independently verified against the signer's own family
        // clusterId (would need an extra get() here) — same trust level
        // already given to contributedByName. A wrong value here at worst
        // means a pick shows in the wrong cluster's feed, not a privacy
        // issue, unlike the community-message admin check above.
        && request.resource.data.clusterId is string
        && request.resource.data.clusterId.size() > 0;
      // Only the original contributor can edit their own contribution, and
      // only its fields/attribution name — type, who contributed it, and
      // when are all pinned to their original value.
      allow update: if request.auth != null
        && resource != null
        && resource.data.contributedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fields', 'contributedByName']);
      // Only the original contributor can delete their own contribution.
      allow delete: if request.auth != null
        && resource != null
        && resource.data.contributedByUid == request.auth.uid;
    }

    // Broadcast announcements from a cluster admin (see functions/index.js's
    // CLUSTERS comment for what a "cluster" is) — every signed-in family
    // reads the whole feed (app/messages/community.tsx filters to its own
    // clusterId client-side), but only that cluster's admin(s) can post to
    // it. request.auth.token.email works here (unlike a Firestore lookup)
    // because Firebase's own ID token already carries the signer's email
    // as a standard claim — no custom claims or extra doc read needed.
    // One ||'d clause per cluster below, kept in sync with
    // functions/index.js's CLUSTERS and lib/clusters.ts (rules can't
    // import a JS constant) — add a clause here for each new cluster's
    // admin list as clusters are added.
    match /communityMessages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (
          (request.resource.data.clusterId == 'bay-area' && request.auth.token.email in ['joshuaefron5890@gmail.com'])
        )
        && request.resource.data.postedByUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0;
      allow update, delete: if false;
    }

    // Sitters (see functions/index.js's toPublicSitter comment) are a
    // completely separate account type from families — self-registered,
    // vetted by a cluster admin. A sitter can only ever read/write their
    // OWN doc; every other family sees a public subset through
    // getRecommendedSitters (Cloud Function, Admin SDK), same reasoning as
    // toPublicFamily. backgroundCheckStatus/vettedAt/vettedByEmail are
    // pinned out of every client write — setSitterVettingStatus (Admin SDK,
    // admin-gated) is the only path that ever sets them, so self-vetting
    // isn't possible even in principle.
    match /sitters/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.backgroundCheckStatus == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'phone', 'bio', 'photoUrl', 'city', 'state', 'zipCode',
          'clusterId', 'specialties', 'certifications', 'yearsExperience', 'hourlyRate', 'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
