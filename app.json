{
  "expo": {
    "name": "Haven.ly",
    "slug": "havenly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "havenly",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.315662747088-68bt1tt941lf7jcecb7t6n87huqd1t7l"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Haven.ly uses your photos to let you add a picture to your family profile or a community contribution.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/8c78da10-6b71-4419-a28b-7943ea5ae865"
    },
    "extra": {
      "eas": {
        "projectId": "8c78da10-6b71-4419-a28b-7943ea5ae865"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joshuaefronsteam.havenly",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.joshuaefronsteam.havenly",
      "adaptiveIcon": {
        "backgroundColor": "#E8734A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    }
  }
}
